# MacWhisper Skill — environment overrides
#
# No configuration is required for a standard MacWhisper installation.
# Copy this file to .env and uncomment only the lines you need to change.

# Path to MacWhisper's SQLite database.
# Default: ~/Library/Application Support/MacWhisper/Database/main.sqlite
# MACWHISPER_DB_PATH=/custom/path/to/main.sqlite

# Path where the processed-sessions state file is written.
# Default: macwhisper-state.json in the current working directory (your project root).
# MACWHISPER_STATE_FILE=/custom/path/to/macwhisper-state.json

# Display label for the user's own microphone track.
# MacWhisper internally calls this track "Microphone"; the skill renames it for readability.
# Default: Me
# MACWHISPER_MIC_LABEL=Me
