        {"action": "text", "id": "pole-detail", "value": "Crew notified"},
        {"action": "text", "id": "pole-detail", "value": "SL-5826"},
        {"action": "hidden", "id": "submit-report"}
      ],
      "capture": true
    },
    {
      "name": "Recover from an empty search",
      "width": 834,
      "steps": [
